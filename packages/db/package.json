{
  "name": "@steward/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed-dataset": "./src/seed/mockup-dataset.ts",
    "./password": "./src/password.ts",
    "./postgres": "./src/client/postgres.ts",
    "./pglite": "./src/client/pglite.ts",
    "./migrations-path": "./src/migrations-path.ts",
    "./testing": "./src/testing/engines.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../apps/api/.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../apps/api/.env src/scripts/seed.ts"
  },
  "devDependencies": {
    "@steward/config": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@node-rs/argon2": "2.2.2",
    "@steward/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "uuid": "14.0.3",
    "zod": "4.6.5"
  }
}
