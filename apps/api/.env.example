# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=4000
# Matches docker-compose.dev.yml (use :5433 if you started it with POSTGRES_PORT=5433).
# Never commit real credentials.
DATABASE_URL=postgres://steward:steward@localhost:5432/steward
# The web app's origin, allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Migrations run as a role that may change the schema; defaults to DATABASE_URL in development.
# MIGRATION_DATABASE_URL=postgres://steward:steward@localhost:5432/steward
