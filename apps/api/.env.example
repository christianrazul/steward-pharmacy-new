# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=4000
# Matches docker-compose.dev.yml. Never commit real credentials.
DATABASE_URL=postgres://steward:steward@localhost:5432/steward
# The web app's origin, allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
