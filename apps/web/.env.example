# Copy to apps/web/.env.local for local development.
# Where the browser reaches the API. A full URL in development; "/api" in production behind Caddy.
NEXT_PUBLIC_API_URL=http://localhost:4000
# remote: talk to the API (needs `pnpm db:up`, migrate and seed). fake: in-memory demo data, no backend.
NEXT_PUBLIC_DATA_SOURCE=remote
# development | staging | production. Production builds refuse the development tools below.
NEXT_PUBLIC_DEPLOY_ENV=development
# Shows the temporary "Preview as" role switcher and the demo accounts. Development only.
NEXT_PUBLIC_DEV_ROLE_SWITCHER=true
