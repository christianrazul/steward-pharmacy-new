# Copy to apps/web/.env.local for local development.
# Baked into the static build at build time, so it must be a public URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Shows the temporary "Preview as" role switcher and the fake offline toggle.
# Development only. Leave unset or false for production builds.
NEXT_PUBLIC_DEV_ROLE_SWITCHER=true
