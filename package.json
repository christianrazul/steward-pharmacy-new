{
  "name": "steward-pharmacy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint *.js",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @steward/db migrate",
    "db:seed": "pnpm --filter @steward/db seed",
    "db:generate": "pnpm --filter @steward/db generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@steward/config": "workspace:*",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "electron",
      "esbuild"
    ]
  }
}
